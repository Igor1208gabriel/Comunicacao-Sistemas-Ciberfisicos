package Ros_Messages_Properties
public
	with Other_Properties; 
	data topic
	end topic;
	
	data implementation topic.impl
	end topic.impl;
	
	-- Topicos
	
	data std_msgs extends topic --Pacote onde o to´pico esta´descrito
		end std_msgs;
	data implementation std_msgs.impl 
		end std_msgs.impl;
	
	data string extends std_msgs --Tópico String. Tamanho é variavel, mas aqui botei fixo
		end string;
	data implementation string.impl extends std_msgs.impl
		end string.impl;
	
	data sensor_msgs extends topic
		end sensor_msgs;
	data implementation sensor_msgs.impl extends topic.impl
		end sensor_msgs.impl;
	
	data image extends sensor_msgs
		end image;
	data implementation image.atumalaca_impl extends sensor_msgs.impl
		properties 
			data_Size => 95040 Bytes; --360 * 264 * 3 canais RGB
		end image.atumalaca_impl;
		
		
		
	thread publishthread
		features
	  in_port: in event data port Other_Properties::videostream.atumalaca_impl;
      out_port: out event data port image.atumalaca_impl; -- publica mensagens
  		end publishthread;
	thread implementation publishthread.impl
	  end publishthread.impl;
	 
	thread subscriberthread
    features
      in_port: in event data port image.atumalaca_impl; -- recebe mensagens
  		end subscriberthread;
	thread implementation subscriberthread.impl
	  end subscriberthread.impl;
	
end Ros_Messages_Properties;

property set Ros_Properties is

	Default_Queue_Size: constant aadlinteger => 512;

	Default_Period: constant Time => 10MS;

	Default_Compute_Execution_Time: constant Time_Range => 1MS .. 100MS;

	Number_Of_Spinners: aadlinteger => 1 applies to (process);

	SpinnersTypes: type enumeration (single, multithreaded, async);
	SpinnersType: Ros_Properties::SpinnersTypes applies to (process);

end Ros_Properties;

package Ros
public

	with Sei;
	with Ros_Properties;
	with Ros_Data;

-- This package is intended to model fundamental mechanisms in the ROS middle-ware.
-- A ROS based application is made of nodes communicating through topics, thanks to
-- a publish and subscribe mechanism.
-- ROS is organized such as a master node takes communications and synchronization
-- of every other node in charge.
-- This package provides definitions of basic elements that are used in the models of
-- components in or library of ROS nodes.
-- contributor: Eric SENN
------------
-- ROS SYSTEM
------------
	system Ros_System
	end Ros_System;

	system implementation Ros_System.Impl
		subcomponents
			Ros_Virtual_Bus: bus Ros_Bus.No_Taskset;
	end Ros_System.Impl;

--------------------------
-- ROS VIRTUAL BUS : TCPROS
--------------------------
-- Communications between nodes in ROS are seen as happening on a virtual bus with its own Bandwidth capacity 
-- ROS2 is built on top of DDS/RTPS as its middleware, which provides discovery, serialization and transportation.
-- The so-called ROS MiddleWare interface RMW allows to use different DDS implementation
-- from different DDS providers. Out of the box supported DDS and corresponding RMW are  
-- eProsima Fast DDS : rmw_fastrtps_cpp
-- Eclipse Cyclone DDS : rmw_cyclonedds_cpp
-- RTI Connext DDS : rmw_connextdds
-- We finally use a regular bus to model the ROS virtual bus because
-- bandwidth capacity does not apply to AADL virtual bus
	bus Ros_Bus
	end Ros_Bus;

	bus implementation Ros_Bus.Impl
	end Ros_Bus.Impl;

-- ROS2 virtual bus implementation for rmw_cyclonedds_cpp
	bus implementation Ros_Bus.No_Taskset extends Ros_Bus.Impl
		properties
			Sei::BandWidthCapacity => 122.0 MBytesps;
	end Ros_Bus.No_Taskset;

-- Our measurements show that the virtual bus speed his impacted by
-- the hardware on which the communicating nodes are running.
-- implementation on the Odroid XU4 / A15 cores
	bus implementation Ros_Bus.Xu4_A15 extends Ros_Bus.Impl
		properties
			Sei::BandWidthCapacity => 166.0 MBytesps;
	end Ros_Bus.Xu4_A15;

-- implementation on the Odroid XU4 / A7 cores
	bus implementation Ros_Bus.Xu4_A7 extends Ros_Bus.Impl
		properties
			Sei::BandWidthCapacity => 71.0 MBytesps;
	end Ros_Bus.Xu4_A7;

----------------------
-- Cyclone DDS over Ethernet
----------------------
	BUS Ros_Ethernet
	end Ros_Ethernet;

	bus implementation Ros_Ethernet.Impl
	end Ros_Ethernet.Impl;

	bus implementation Ros_Ethernet.No_Taskset extends Ros_Ethernet.Impl
		properties
			Sei::BandWidthCapacity => 253.0 MBytesps;
	end Ros_Ethernet.No_Taskset;

------------------
-- Cyclone DDS over wifi
------------------
	BUS Ros_Wifi
	end Ros_Wifi;

	bus implementation Ros_Wifi.Impl
	end Ros_Wifi.Impl;

	bus implementation Ros_Wifi.No_Taskset extends Ros_Wifi.Impl
		properties
			Sei::BandWidthCapacity => 173.0 MBytesps;
	end Ros_Wifi.No_Taskset;

--------------------------------
-- Virtual bus for /tf messages
--------------------------------
--virtual bus tf_bus
	--end tf_bus;
--from [Morten16] "Modeling Field Robot Software Using AADL"
--virtual bus ros_ipc
--properties
--SEI::BandWidthCapacity => 10.0 GBytesps;--!! BandWidthCapacity does not apply to virtual bus!!!!!!
--Latency => 2 us .. 1 ms ;
--Transmission_Time => [ Fixed => 1 us .. 20 us ;
--PerByte => 1 ns .. 1 ns ; ] ;
--end ros_ipc;
---------------------------------------------------------------------------------
---------------------------------------------------------------------------------
--THREADS------------------------------------------------------------------------
---------------------------------------------------------------------------------
---------------------------------------------------------------------------------
-- A ROS node is modeled as an AADL process component.
-- Every of this process will include several threads mimicking
-- the actual ROS node code. The main threads that are found running
-- in a ROS node are :
-- Generic ROS thread type and implementation to be extended
-- by any other threads in our model.
	thread Ros_Thread
		properties
			Period => Ros_properties::Default_Period;
			Dispatch_Protocol => Periodic;
			Compute_Execution_Time => Ros_properties::Default_Compute_Execution_Time;
--    Deadline => 9 Ms;
	end Ros_Thread;

	thread implementation Ros_Thread.Impl
	end Ros_Thread.Impl;

--------------------------------------------------------------------
-- The main thread in every node
--------------------------------------------------------------------
	thread Main extends Ros_Thread
	end Main;

	thread implementation Main.Impl extends Ros_Thread.Impl
	end Main.Impl;

--------------------------------------------------------------------
-- The spinner thread
-- keeps taking the callbacks from the callback queue and executing them one by
-- one in an infinite loop acting as a “spinning” thread
--------------------------------------------------------------------
	thread Spinner extends Ros_Thread
	end Spinner;

	thread implementation Spinner.Impl extends Ros_Thread.Impl
	end Spinner.Impl;

--------------------------------------------------------------------
-- A thread type to impPROCESS IMPLEMENTATIONlement callback functions in nodes
-- from [Bardaro19] "From Models To Software Through Automatic Transformations:
-- An AADL To ROS end-to-end Toolchain"
--------------------------------------------------------------------
	thread Callback extends Ros_Thread
		--features
		--message: out data port;
	end Callback;

	thread implementation Callback.Impl extends Ros_Thread.Impl
		subcomponents
			Message: data Ros_Data::Topic;
	end Callback.Impl;

-------------------------------------------------------------------
-- A thread type to implement publishers in nodes--
-------------------------------------------------------------------
	thread Publisher extends Ros_Thread
		features
			Pub_Msg: out event data port;
		properties
			Queue_Size => Ros_properties::Default_Queue_Size applies to Pub_Msg;
	end Publisher;

	thread implementation Publisher.Impl extends Ros_Thread.Impl
	end Publisher.Impl;

-------------------------------------------------------------------
-- A thread type to implement subscribers in nodes
-- a subscriber is associated to a callback function that is called
-- to deal with the data received on the topic listened to
-------------------------------------------------------------------
	thread Subscriber extends Ros_Thread
		features
			Subs_Msg: IN EVENT DATA PORT;
	end Subscriber;

	thread implementation Subscriber.Impl extends Ros_Thread.Impl
	end Subscriber.Impl;

-------------------------------------------------------------------
-- A thread type to implement TF broadcaster in nodes
-------------------------------------------------------------------
	thread TransformBroadcaster extends Ros_Thread
		features
			Tf_Broadcasted: out event data port Ros_Data::TfMessage.Impl;
	end TransformBroadcaster;

	thread implementation TransformBroadcaster.Impl extends Ros_Thread.Impl
	end TransformBroadcaster.Impl;

-------------------------------------------------------------------
-- A thread type to implement TF listener in nodes
-------------------------------------------------------------------
	thread TransformListener extends Ros_Thread
		features
			Tf_Listened: in event data port;
	end TransformListener;

	thread implementation TransformListener.Impl extends Ros_Thread.Impl
	end TransformListener.Impl;

--------------------------------------------------------------------
-- A thread to provide a service to a requesting node
--------------------------------------------------------------------
	thread ServiceProvider extends Ros_Thread
	end ServiceProvider;

	thread implementation ServiceProvider.Impl extends Ros_Thread.Impl
	end ServiceProvider.Impl;

--------------------------------------------------------------------
-- A timer thread	
--------------------------------------------------------------------
	thread Timer extends Ros_Thread
	end Timer;

	thread implementation Timer.Impl extends Ros_Thread.Impl
	end Timer.Impl;

---------------------------------------------------------------------------------
---------------------------------------------------------------------------------
-- ROS NODES --------------------------------------------------------------------
---------------------------------------------------------------------------------
---------------------------------------------------------------------------------
-- A robot software based on ROS is a constellation of nodes communicating
-- through topics.
-- A dedicated package is written for every node that we want to include in our library.
-- Every node in those packages will inherit from the following node component type
-- and implementation.
-- One ROS node has one spinner thread by default. However, several spinners 
-- could be spawned to allow for multiple concurrent executions of callback functions \cite{Valigi19}.
	process Node
		properties
			Ros_properties::Number_Of_Spinners => 1;
	end Node;

	process implementation Node.Impl
	end Node.Impl;

end Ros;

package System_implementation
public
	with Devices;
	with Nodes;
	
	system webcamsystem
	end webcamsystem;
	
	system implementation webcamsystem.impl
		subcomponents 
			Webcam: device Devices::webcam.impl;
			Publishercamera: process Nodes::publishercamera.impl;
			Displaycamera: process Nodes::displaycamera.impl;
		connections
			con1: port Webcam.cam_out -> Publishercamera.Webcam_Stream_In;
			con2: port Publishercamera.Video_Stream_Out -> Displaycamera.Video_Stream_In;
	end webcamsystem.impl;
	
end System_implementation;