package Devices
public
	with Other_Properties;
	
	device webcam
		features 
			cam_out: out data port Other_Properties::videostream.atumalaca_impl;
	end webcam;
	device implementation webcam.impl
	end webcam.impl;
	
end Devices;

package Nodes
public
	With Ros_Messages_Properties;
	with Other_Properties;
	--with Devices;
	
	
	
	process node
	end node;
	process implementation node.impl
	end node.impl;
	
	-----------------------------------------------------------------------------
	
	process publishercamera extends node
		features
			Webcam_Stream_in: in event data port Other_Properties::videostream.atumalaca_impl;
			Video_Stream_out: out event data port Ros_Messages_Properties::image.atumalaca_impl;
	end publishercamera;
	
	process implementation publishercamera.impl extends node.impl
		subcomponents 
			Pub: thread Ros_Messages_Properties::publishthread.impl;
		connections 
			cam_in: port Webcam_Stream_in -> Pub.in_port;
			cam_out: port Pub.out_port -> Video_Stream_out;
	end publishercamera.impl;
	
	-----------------------------------------------------------------------------
	
	process displaycamera extends node
		features
			Video_Stream_in: in event data port Ros_Messages_Properties::image.atumalaca_impl;
	end displaycamera;
	
	process implementation displaycamera.impl extends node.impl
		-- TODO: implementar saida do vídeo por CV2
		subcomponents 
			Sub: thread Ros_Messages_Properties::subscriberthread.impl;
		connections
			cam_in: port Video_Stream_in -> Sub.in_port;
	end displaycamera.impl;
	
	-----------------------------------------------------------------------------
	
		
end Nodes;

package Other_Properties
public
	data datastream	
	end datastream;
	data implementation datastream.impl	
	end datastream.impl;
	
	data videostream extends datastream	
	end videostream;
	data implementation videostream.impl extends datastream.impl	
	end videostream.impl;
	
	data implementation videostream.atumalaca_impl extends datastream.impl
		properties
			Data_size => 95040 Bytes;
	end videostream.atumalaca_impl;
	
end Other_Properties;

