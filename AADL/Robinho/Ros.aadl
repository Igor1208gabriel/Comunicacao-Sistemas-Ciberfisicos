package Ros
public

	with Sei;
	with Ros_Properties;

-- This package is intended to model fundamental mechanisms in the ROS middle-ware.
-- A ROS based application is made of nodes communicating through topics, thanks to
-- a publish and subscribe mechanism.
-- ROS is organized such as a master node takes communications and synchronization
-- of every other node in charge.
-- This package provides definitions of basic elements that are used in the models of
-- components in or library of ROS nodes.
-- contributor: Eric SENN
------------
-- ROS SYSTEM
------------
	system Ros_System
	end Ros_System;

	system implementation Ros_System.Impl
		subcomponents
			Ros_Virtual_Bus: bus Ros_Bus.No_Taskset;
	end Ros_System.Impl;

--------------------------
-- ROS VIRTUAL BUS : TCPROS
--------------------------
-- Communications between nodes in ROS are seen as happening on a virtual bus with its own Bandwidth capacity 
-- ROS2 is built on top of DDS/RTPS as its middleware, which provides discovery, serialization and transportation.
-- The so-called ROS MiddleWare interface RMW allows to use different DDS implementation
-- from different DDS providers. Out of the box supported DDS and corresponding RMW are  
-- eProsima Fast DDS : rmw_fastrtps_cpp
-- Eclipse Cyclone DDS : rmw_cyclonedds_cpp
-- RTI Connext DDS : rmw_connextdds
-- We finally use a regular bus to model the ROS virtual bus because
-- bandwidth capacity does not apply to AADL virtual bus
	bus Ros_Bus
	end Ros_Bus;

	bus implementation Ros_Bus.Impl
	end Ros_Bus.Impl;

-- ROS2 virtual bus implementation for rmw_cyclonedds_cpp
	bus implementation Ros_Bus.No_Taskset extends Ros_Bus.Impl
		properties
			Sei::BandWidthCapacity => 122.0 MBytesps;
	end Ros_Bus.No_Taskset;

-- Our measurements show that the virtual bus speed his impacted by
-- the hardware on which the communicating nodes are running.
-- implementation on the Odroid XU4 / A15 cores
	bus implementation Ros_Bus.Xu4_A15 extends Ros_Bus.Impl
		properties
			Sei::BandWidthCapacity => 166.0 MBytesps;
	end Ros_Bus.Xu4_A15;

-- implementation on the Odroid XU4 / A7 cores
	bus implementation Ros_Bus.Xu4_A7 extends Ros_Bus.Impl
		properties
			Sei::BandWidthCapacity => 71.0 MBytesps;
	end Ros_Bus.Xu4_A7;

----------------------
-- Cyclone DDS over Ethernet
----------------------
	BUS Ros_Ethernet
	end Ros_Ethernet;

	bus implementation Ros_Ethernet.Impl
	end Ros_Ethernet.Impl;

	bus implementation Ros_Ethernet.No_Taskset extends Ros_Ethernet.Impl
		properties
			Sei::BandWidthCapacity => 253.0 MBytesps;
	end Ros_Ethernet.No_Taskset;

------------------
-- Cyclone DDS over wifi
------------------
	BUS Ros_Wifi
	end Ros_Wifi;

	bus implementation Ros_Wifi.Impl
	end Ros_Wifi.Impl;

	bus implementation Ros_Wifi.No_Taskset extends Ros_Wifi.Impl
		properties
			Sei::BandWidthCapacity => 173.0 MBytesps;
	end Ros_Wifi.No_Taskset;

--------------------------------
-- Virtual bus for /tf messages
--------------------------------
--virtual bus tf_bus
	--end tf_bus;
