package SoftwareSystem
public
	with Nodes;
	with Raspberry;

	system SoftwareSystem
		features
			Cam_in: requires bus access Raspberry::AMBA.impl;
			HDMI_Out: requires bus access Raspberry::AMBA.impl;

			GPIO_Out: out event data port;
	end SoftwareSystem;

	system implementation SoftwareSystem.color_tracker

		subcomponents
			usb_cam: process Nodes::usb_cam_node.impl;
			img_filter: process Nodes::image_filter.impl;
			img_display1: process Nodes::image_display.one_impl;
			img_display2: process Nodes::image_display.two_impl;
			color_tracker: process Nodes::color_tracker.impl;
			pos2cmd: process Nodes::pos2cmd_vel.impl;

		connections
			SoftwareSystem_color_tracker_new_connection: port usb_cam.image_raw -> img_display1.image_in;
			SoftwareSystem_color_tracker_new_connection2: port usb_cam.image_raw -> img_filter.image_in;
			SoftwareSystem_color_tracker_new_connection3: port img_filter.filtered_out -> color_tracker.filtered_in;
			SoftwareSystem_color_tracker_new_connection4: port color_tracker.pos_color_out -> pos2cmd.posicao_in;
			SoftwareSystem_color_tracker_new_connection5: port img_filter.filtered_out -> img_display2.image_in;
			SoftwareSystem_color_tracker_new_connection6: feature Cam_in -> usb_cam.Cam_in;
			SoftwareSystem_color_tracker_new_connection7: feature img_display1.image_out -> HDMI_Out;
			SoftwareSystem_color_tracker_new_connection9: feature pos2cmd.cmd_vel_out -> GPIO_Out;
			SoftwareSystem_color_tracker_new_connection10: feature img_display2.image_out -> HDMI_Out;
	end SoftwareSystem.color_tracker;

end SoftwareSystem;