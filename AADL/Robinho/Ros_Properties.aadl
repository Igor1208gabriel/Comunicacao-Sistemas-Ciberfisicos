property set Ros_Properties is

	Default_Queue_Size: constant aadlinteger => 512;

	Default_Period: constant Time => 10MS;

	Default_Compute_Execution_Time: constant Time_Range => 1MS .. 100MS;

	Number_Of_Spinners: aadlinteger => 1 applies to (process);

	SpinnersTypes: type enumeration (single, multithreaded, async);
	SpinnersType: Ros_Properties::SpinnersTypes applies to (process);

end Ros_Properties;