package Robinho
public
	with Raspberry;
	with Ros;

	system robinho
	end robinho;

	system implementation robinho.impl
		subcomponents
			Raspberry: system Raspberry::Raspberry.impl;
			ROS: system Ros::Ros_System.Impl;
		properties 
			Actual_Processor_Binding => (reference (Raspberry.Proc1))
				applies to ROS;
	end robinho.impl;
end Robinho;