-- contributor: Eric SENN
-- TOPICS ---------------------------------------------------------------------------
-------------------------------------------------------------------------------------
	data Topic
	end Topic;

	data implementation Topic.Impl
	end Topic.Impl;

--ACTIONLIB MSGS -----------------------------------------------
	data Actionlib_Msgs extends Topic
	end Actionlib_Msgs;

	data GoalID extends Actionlib_Msgs
	end GoalID;

	data implementation GoalID.Impl
	end GoalID.Impl;

--GEOMETRY MSGS -------------------------------------------------	
	data Geometry_Msgs extends Topic
	end Geometry_Msgs;

	data implementation Geometry_Msgs.Impl
	end Geometry_Msgs.impl;

	data AccelWithCovarianceStamped
	end AccelWithCovarianceStamped;

	data implementation AccelWithCovarianceStamped.Impl
	end AccelWithCovarianceStamped.Impl;

	data Twist extends Geometry_Msgs
	end Twist;

	data implementation Twist.Impl extends Geometry_Msgs.Impl
		properties
			data_Size => 50 Bytes;
	end Twist.Impl;

	data Point extends Geometry_Msgs
		properties
			data_Size => 24 Bytes;
	end Point;

	data implementation Point.Impl extends Geometry_Msgs.Impl
	end Point.Impl;

	data Pose extends Geometry_Msgs
	end Pose;

	data implementation Pose.Impl extends Geometry_Msgs.Impl
	end Pose.Impl;

	data Polygon extends Geometry_Msgs
	end Polygon;

	data implementation Polygon.Rover extends Geometry_Msgs.Impl
	end Polygon.Rover;

	data implementation Polygon.leo_rover extends Geometry_Msgs.Impl
	end Polygon.leo_rover;

