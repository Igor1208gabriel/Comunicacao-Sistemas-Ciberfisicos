	data Move_Base_Msgs extends Topic
	end Move_Base_Msgs;

	data implementation Move_Base_Msgs.Impl extends Topic.Impl
	end Move_Base_Msgs.Impl;

	data MoveBaseActionGoal extends Move_Base_Msgs
	end MoveBaseActionGoal;

	data implementation MoveBaseActionGoal.Impl extends move_base_msgs.Impl
	end MoveBaseActionGoal.Impl;

	data MoveBaseGoal extends Move_Base_Msgs
	end MoveBaseGoal;

	data implementation MoveBaseGoal.Impl extends Move_Base_Msgs.Impl
