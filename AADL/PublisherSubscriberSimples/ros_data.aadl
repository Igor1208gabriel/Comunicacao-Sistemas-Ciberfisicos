--SENSOR MSGS ----------------------------------------------------------
	data Sensor_Msgs extends Topic
	end Sensor_Msgs;

	data implementation Sensor_Msgs.Impl extends Topic.Impl
	end Sensor_Msgs.Impl;

	data Imu extends Sensor_Msgs
	end Imu;

	data implementation Imu.Impl extends Sensor_Msgs.Impl
	end Imu.Impl;

	data Joy extends Sensor_Msgs
	end Joy;

	data implementation Joy.Impl extends Sensor_Msgs.Impl
	end Joy.Impl;

	data PointCloud extends Sensor_Msgs
	end PointCloud;

	data implementation PointCloud.Impl
	end PointCloud.Impl;

	data Sonarscan extends PointCloud
	end Sonarscan;

	data implementation Sonarscan.Impl extends PointCloud.Impl
		properties
			data_Size => 220 Bytes;
	end Sonarscan.Impl;

	data PointCloud2 extends Sensor_Msgs
	end PointCloud2;

	data implementation PointCloud2.Impl
	end PointCloud2.Impl;

	data Laserscan extends Sensor_Msgs
	end LaserScan;

	data implementation Laserscan.Impl extends Sensor_Msgs.Impl
	end LaserScan.Impl;

	data implementation Laserscan.A2M8 extends sensor_msgs.impl
		properties
			data_Size => 2940 Bytes;
	end Laserscan.A2M8;

	data implementation Laserscan.tb3GZ extends Sensor_Msgs.Impl
		properties
			data_Size => 2940 Bytes;
	end Laserscan.Tb3GZ;

	data Image extends Sensor_Msgs
	end Image;

	data implementation Image.Impl extends Sensor_Msgs.Impl
	end Image.Impl;

--640x480 RGB images 8bits per channel, 3 channels	
	data implementation Image.rgb extends Image.impl
		properties
			--640x480x3=921600 Bytes #0.92MBytes
			data_Size => 921 KByte;
	end Image.Rgb;

--STANDARD STD MESSAGES------------------------------------------------
	data Std_Msgs extends Topic
	end Std_Msgs;

	data Bool extends Std_Msgs
	end Bool;

	data implementation Bool.Impl
		properties
			data_Size => 1 Bytes;
	end Bool.Impl;

--std_msgs/UInt8.msg
	data Int8 extends Std_Msgs
	end Int8;

	data implementation Int8.Impl
	end Int8.Impl;

	data Float32 extends Std_Msgs
